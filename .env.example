# Email Configuration (Resend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=no-reply@your-verified-domain.com
ADMIN_EMAIL=3d.print.ittt@gmail.com

# Supabase (Frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase (Netlify Functions / server-side only)
SUPABASE_URL=https://your-project-ref.supabase.co
# Use service role for admin APIs. For public catalog only, anon key is enough:
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional duplicate of anon key for functions (or rely on VITE_SUPABASE_ANON_KEY in Netlify env)
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images

# Admin auth policy (comma-separated emails allowed to use admin APIs)
ADMIN_EMAILS=3d.print.ittt@gmail.com

# The old built-in STL upload / quote flow (replaced by 3D Print OS) is OFF by default.
# Its endpoints take anonymous uploads and send email, so only set this to true if you
# deliberately bring that flow back.
# LEGACY_QUOTE_FLOW_ENABLED=false

# Shopify catalogue (headless). Leave VITE_CATALOG_SOURCE unset to keep reading products from Supabase.
# The Storefront token is the PUBLIC one (safe in the browser). Never put an Admin API token here.
# VITE_CATALOG_SOURCE=shopify
# VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# VITE_SHOPIFY_STOREFRONT_TOKEN=your_public_storefront_token
# VITE_SHOPIFY_API_VERSION=2026-07

# Optional: override the same-origin API during local development
# VITE_API_URL=http://localhost:8888/api

