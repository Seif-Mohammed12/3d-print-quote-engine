# Email Configuration (Resend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=no-reply@your-verified-domain.com
ADMIN_EMAIL=3d.print.ittt@gmail.com

# Supabase (Frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase (Netlify Functions / server-side only)
SUPABASE_URL=https://your-project-ref.supabase.co
# Use service role for admin APIs. For public catalog only, anon key is enough:
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional duplicate of anon key for functions (or rely on VITE_SUPABASE_ANON_KEY in Netlify env)
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images

# Admin auth policy (comma-separated emails allowed to use admin APIs)
ADMIN_EMAILS=3d.print.ittt@gmail.com

# Optional: override the same-origin API during local development
# VITE_API_URL=http://localhost:8888/api

